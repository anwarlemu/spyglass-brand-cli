{
  "name": "spyglass-ds",
  "version": "0.1.0",
  "private": true,
  "description": "The Spyglass brand system in one CLI: tokens, logos, fonts, the brand light and ASCII texture, a React and web component library, and checks that keep pages, assets and interfaces on brand.",
  "type": "module",
  "bin": {
    "spyglass-ds": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "brand",
    "build",
    "r",
    "elements"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/www"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-brand.mjs",
    "registry": "bun scripts/build-registry.ts",
    "test": "vitest run",
    "test:docs": "node scripts/check-docs.mjs",
    "ci": "bun run build && node scripts/ci-limits.mjs && bun run registry && vitest run",
    "release": "sh scripts/release.sh",
    "www:build": "bun run --cwd apps/www build",
    "registry:release": "bun scripts/build-registry.ts --require-all-flavors",
    "elements": "node scripts/build-elements.mjs",
    "parity": "node scripts/check-parity.mjs",
    "port-order": "node scripts/port-order.mjs"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.10.4",
    "@tailwindcss/node": "^4.2.2",
    "@tailwindcss/oxide": "^4.2.2",
    "@types/node": "^25.3.5",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "esbuild": "0.25.11",
    "lit": "3.3.1",
    "lucide": "0.479.0",
    "lucide-react": "0.479.0",
    "pixelmatch": "7.1.0",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "^4.2.2",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "^4.0.0",
    "@tailwindcss/vite": "^4.2.2"
  },
  "dependencies": {
    "@babel/parser": "7.29.3",
    "@resvg/resvg-js": "^2.6.2",
    "@vue/compiler-sfc": "3.5.43",
    "jpeg-js": "0.4.4",
    "opentype.js": "^2.0.0",
    "tailwindcss": "4.3.4",
    "wawoff2": "^2.0.1"
  }
}
