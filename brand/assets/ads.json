{
 "$comment": "`always` lists must-haves every ad keeps whatever the brief says (the logo: an ad without the brand mark is not an ad of the brand). How `ad` turns a brief into ads: which layouts (image templates and compose recipes) can carry which brief fields, what each suits, and how they rank. The layouts themselves live in image.json, layouts.mjs and recipes.json; restyle those and these entries keep working. `fields` maps a brief field to the template's slot or the recipe's block.slot; `pictures` names the picture kinds a layout takes (template: kinds, min, max; recipe: block id to kinds); `needs` are brief fields it cannot draw without; `sizes` limits a layout to those sizes (templates default to their own, recipes to their size list). Every candidate is drawn and checked; one that breaks a rule or stops reading at a size is skipped for the next. Sample copy is Acme only.",
 "goals": {
  "launch": ["launch", "launches", "launching", "announce", "announcing", "announcement", "introduce", "introducing", "release", "ship", "ships", "shipping", "available", "new"],
  "offer": ["offer", "price", "pricing", "discount", "sale", "plan", "plans", "trial", "deal", "upgrade", "promo", "promotion", "off", "save"],
  "feature": ["feature", "features", "show", "showcase", "capability", "explain", "demo", "workflow", "how"],
  "story": ["customer", "customers", "story", "stories", "case", "testimonial", "quote", "review", "proof"],
  "hiring": ["hiring", "hire", "job", "jobs", "career", "careers", "recruit", "recruiting", "join", "team", "roles", "role", "engineer", "designer"],
  "event": ["event", "webinar", "meetup", "conference", "livestream", "summit", "workshop"],
  "awareness": ["awareness", "brand", "reach", "remind"]
 },
 "required": {
  "all": ["headline", "cta"],
  "story": ["quote", "cta"],
  "offer": ["headline", "cta", "offer"],
  "pricing-card": ["offer"]
 },
 "always": ["logo"],
 "score": { "goal": 6, "offGoal": -3, "look": 2, "field": 1, "leftOut": -2, "lead": -3, "noLogo": -4 },
 "themes": { "dark": ["black"], "light": ["white"], "any": ["black", "white"], "bold-dark": ["blue", "magenta", "red"], "bold-light": ["yellow", "green"] },
 "sample": {
  "headline": "Every competitor ad, the day it ships.",
  "supporting": "Search the ads and posts every brand in your market runs.",
  "cta": "Start free",
  "offer": "$20 a month",
  "plan": "Creator",
  "features": "Every network | Daily updates | Shared boards",
  "label": "New",
  "quote": "We see every launch the day it ships.",
  "name": "Alex Kim",
  "role": "Head of growth, Acme",
  "stat": "3x | faster launch reviews",
  "search": "Longest-running ads in running shoes"
 },
 "musts": [
  { "words": ["price", "pricing", "offer", "the offer", "the price"], "field": "offer" },
  { "words": ["cta", "button", "call to action", "the cta", "the button"], "field": "cta" },
  { "words": ["supporting line", "supporting", "subhead", "the supporting line"], "field": "supporting" },
  { "words": ["plan", "plan name", "the plan"], "field": "plan" },
  { "words": ["features", "the features"], "field": "features" },
  { "words": ["label", "eyebrow", "badge", "the label"], "field": "label" },
  { "words": ["stat", "the stat", "figure", "the figure", "number"], "field": "stat" },
  { "words": ["logo", "the logo", "lockup"], "layer": "logo" },
  { "words": ["picture", "pictures", "image", "images", "photo", "the picture", "screenshot", "the screenshot", "product ui", "the product"], "kind": "picture" },
  { "words": ["brand light", "the light", "the brand light", "glow"], "layer": "light" },
  { "words": ["ascii", "texture", "ascii texture", "the texture"], "layer": "texture" },
  { "words": ["pricing card", "plan card", "the pricing card"], "kind": "panel" }
 ],
 "donts": [
  { "words": ["light theme", "light mode", "white", "white ground", "white theme", "white background"], "no": "white" },
  { "words": ["dark theme", "dark mode", "black ground", "black background"], "no": "black" },
  { "words": ["light", "the light", "brand light", "glow", "the glow"], "hide": "light" },
  { "words": ["ascii", "texture", "ascii texture", "the texture"], "hide": "texture" },
  { "words": ["pictures", "picture", "photos", "photo", "images", "image", "screenshots"], "no": "picture" },
  { "words": ["color", "colors", "colored grounds", "spectrum", "colored backgrounds"], "no": "color" },
  { "words": ["pricing card", "plan card", "cards"], "no": "panel" }
 ],
 "layouts": [
  { "id": "post-offer", "from": "template", "fields": { "headline": "headline", "offer": "price", "cta": "cta" }, "goals": ["offer", "launch", "awareness"], "look": ["type", "bold", "light", "ascii"] },
  { "id": "ad-creator-plan", "from": "template", "fields": { "headline": "headline", "plan": "plan", "offer": "price", "features": "features", "cta": "cta" }, "needs": ["offer"], "goals": ["offer"], "look": ["type", "bold", "pricing-card", "light", "ascii"] },
  { "id": "story-offer", "from": "template", "fields": { "headline": "headline", "plan": "plan", "offer": "price", "features": "features", "cta": "cta" }, "needs": ["offer"], "goals": ["offer"], "look": ["type", "pricing-card", "light", "ascii"] },
  { "id": "og-offer", "from": "template", "fields": { "headline": "headline", "offer": "price", "cta": "cta" }, "goals": ["offer", "launch"], "look": ["type", "minimal", "light", "ascii"] },
  { "id": "ad-testimonial", "from": "template", "fields": { "quote": "quote", "name": "name", "role": "role", "cta": "cta" }, "needs": ["quote"], "pictures": { "kinds": ["photo"], "min": 0, "max": 1 }, "goals": ["story"], "look": ["type", "light", "ascii"] },
  { "id": "ad-search-bar", "from": "template", "fields": { "headline": "headline", "supporting": "body", "search": "prompt", "cta": "cta" }, "needs": ["search"], "pictures": { "kinds": ["creative", "screenshot"], "min": 1, "max": 3 }, "goals": ["feature", "launch"], "look": ["picture", "product-ui", "bold"] },
  { "id": "ad-photo", "from": "template", "fields": { "headline": "headline", "supporting": "body", "cta": "cta" }, "pictures": { "kinds": ["photo", "screenshot"], "min": 1, "max": 1 }, "goals": ["launch", "feature", "hiring", "event", "story", "awareness"], "look": ["picture", "minimal"] },
