  { "id": "post-every-market", "from": "template", "fields": { "headline": "headline", "supporting": "body" }, "goals": ["awareness", "feature"], "look": ["type", "bold", "light", "ascii"] },
  { "id": "banner-tagline", "from": "template", "fields": { "headline": "headline" }, "goals": ["awareness", "launch", "hiring", "event"], "look": ["type", "minimal", "light", "ascii"] },
