  { "id": "ad-creative-row", "from": "template", "fields": { "headline": "headline", "cta": "cta" }, "pictures": { "kinds": ["creative", "screenshot"], "min": 3, "max": 6 }, "goals": ["awareness", "feature", "launch"], "look": ["picture", "bold"] },
  { "id": "post-agents", "from": "template", "fields": { "headline": "headline" }, "pictures": { "kinds": ["photo"], "min": 1, "max": 1 }, "goals": ["awareness", "launch"], "look": ["picture", "minimal"] },
  { "id": "story", "from": "template", "fields": { "headline": "headline", "supporting": "body", "cta": "cta" }, "goals": ["launch", "feature", "hiring", "event", "awareness"], "look": ["type", "light", "ascii"] },
