{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": ".",
    "paths": { "@/*": ["registry/*"] }
  },
  "include": ["registry/react/**/*.ts", "registry/react/**/*.tsx", "registry/lib/**/*.ts"]
}
